# ===== Base de datos =====
# URL de conexion a PostgreSQL. En la nube (Neon/Supabase) incluye ?sslmode=require
# Ejemplo Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ===== JWT =====
# Genera secretos largos y aleatorios (obligatorios en produccion).
# Ejemplo para generarlos:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ===== Servidor =====
PORT=3000
NODE_ENV=development

# ===== Frontend =====
# URL del frontend desplegado (para CORS y para los enlaces en los emails).
FRONTEND_URL=http://localhost:5173

# ===== Email (SMTP) — OPCIONAL =====
# Si SMTP_USER queda vacio, los emails NO se envian: solo se registran en consola
# (la demo funciona sin configurar correo).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@clinica.com
